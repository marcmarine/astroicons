{
	"name": "@astroicons/react",
	"version": "0.2.0",
	"description": "React components for Astroicons",
	"license": "MIT",
	"type": "module",
	"main": "./dist/cjs/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/cjs/index.js"
		},
		"./icon": {
			"types": "./dist/icon/index.d.ts",
			"import": "./dist/icon/index.js"
		},
		"./icons/*": {
			"types": "./dist/icons/*.d.ts",
			"import": "./dist/icons/*.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"generate": "bun run scripts/generate.ts",
		"build": "bun run generate && bun scripts/build.ts && tsc --emitDeclarationOnly"
	},
	"peerDependencies": {
		"react": ">=18.0.0"
	},
	"devDependencies": {
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"react": "^19.2.7",
		"svgson": "^5.3.1",
		"typescript": "^5.7.0"
	}
}
